# GitHub / deploy
FAST_FASHION_HOST=127.0.0.1
FAST_FASHION_PORT=8765
FAST_FASHION_API_TOKEN=

# Hugging Face (optional if dataset is public, but keep for private/restricted access)
HF_TOKEN=
HUGGINGFACE_HUB_TOKEN=

# Kaggle credentials
KAGGLE_USERNAME=
KAGGLE_KEY=

# AWS / R2 uploads (secrets only in your local .env or runtime environment)
# Admin password used to unlock the protected S3 upload / migration area.
FAST_FASHION_S3_ADMIN_PASSWORD=
AWS_ENDPOINT_URL=
AWS_URL=
AWS_BUCKET=
AWS_PREFIX=
AWS_REGION=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional outbound proxy for third-party web fetches performed by the app
# All 4 variables must be present together or startup/runtime validation will fail deterministically.
# This affects application egress for dataset/source downloads, not direct boto3 S3 API traffic.
FAST_FASHION_PROXY_HOST=
FAST_FASHION_PROXY_PORT=
FAST_FASHION_PROXY_LOGIN=
FAST_FASHION_PROXY_PASSWORD=

# Local cache path for kagglehub if you choose to use it later
KAGGLEHUB_CACHE=
